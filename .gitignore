# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# uv
.uv/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/
*.ipynb 

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Data (common for biomedical projects)
data/raw/
data/processed/
*.csv
*.tsv
*.parquet
*.h5
*.json
data/**/*.json
*.png
*.pdf

# Allow our designated example/groundtruth datasets
!data/examples/metabolites_synthetic.tsv
!data/examples/metabolites_synthetic_partial_provided.tsv
!data/examples/olink_protein_metadata.tsv
!data/groundtruth/diseases_handcrafted.tsv

# Analysis artifacts that back numbers asserted in source comments. These MUST stay tracked --
# a blanket *.json ignore is exactly how a number ends up cited with no artifact behind it.
!studies/analysis/results/*.json
# The ICD-10-CM twin gate's hand-review sheet travels with its artifact.
!studies/analysis/results/icd10cm_twin_title_review.tsv
# Packaged runtime data (shipped in the wheel; read via importlib.resources).
!src/biomapper2/data/**/*.json
# Committed test fixtures.
!tests/fixtures/**/*.tsv
!tests/fixtures/**/*.json

# Allow release-please config and versioning files
!release-please-config.json
!.release-please-manifest.json

# Other app-specific items
cache/
reports/
.env

# Serena AI tool
.serena/

# memtrace runtime state (rewritten by the local daemon)
.memdb/
