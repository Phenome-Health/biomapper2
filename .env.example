# Kestrel knowledge graph API.
# The public endpoint is the default. It issues keys that start with "kp_"; GET /health reports
# whether one is currently required ("auth_required").
KESTREL_API_URL=https://kestrel.krakenkg.com/api
# A "kp_" key is sent to the public endpoint. Any other key is sent only to a non-public endpoint
# (e.g. KESTREL_API_URL=https://kestrel.nathanpricelab.com/api, which serves a different KRAKEN
# build) and is withheld from the public one. Pin the build with: curl $KESTREL_API_URL/health
# (keyless; reports kg_version, kraken_package_version, biolink_version, git_commit, sources).
KESTREL_API_KEY=your_kestrel_api_key_here

# Optional: protect biomapper2 API endpoints with key(s)
# If unset, the API runs in open-access mode (fine for local use)
# BIOMAPPER_API_KEY=
# BIOMAPPER2_API_KEYS=key1,key2

# Optional: pinned local RefMet freeze (deterministic resolution).
# Path to a frozen /match corpus TSV (see core/annotators/refmet_snapshot.py for the format). When set
# to a loadable file, the RefMet annotator reads the freeze FIRST and the live-endpoint circuit breaker
# leaves the default resolution path (resolution becomes a pure function of name + snapshot version).
# Unset/absent -> live /match (+breaker), unchanged behavior. Relative paths resolve against the repo root.
# REFMET_SNAPSHOT_PATH=/path/to/refmet_freeze_<version>.tsv
# When a freeze is pinned, a name NOT in it resolves deterministically to NO_MATCH (source=not_in_snapshot)
# with no network call. Set this truthy (1/true/yes/on) to instead fall through to live /match for such
# misses -- keeps frozen names deterministic while novel names still resolve (source=live_api). Useful on
# a box that pins a corpus-bound freeze. No effect when no freeze is present.
# REFMET_LIVE_API_FALLBACK=0
